@baseUrl = http://localhost:3000
@productReviewId = 1

### List product reviews
GET {{baseUrl}}/product-reviews

### List product reviews with pagination and filters
GET {{baseUrl}}/product-reviews?limit=10&page=1&productId=1&userId=1&rating=5&status=active

### Get a product review by ID
GET {{baseUrl}}/product-reviews/{{productReviewId}}

### Create a product review
POST {{baseUrl}}/product-reviews
Content-Type: application/json

{
  "rating": 5,
  "comment": "Produto excelente.",
  "userId": 1,
  "productId": 1
}

### Update a product review
PATCH {{baseUrl}}/product-reviews/{{productReviewId}}
Content-Type: application/json

{
  "rating": 4,
  "comment": "Produto muito bom."
}

### Delete a product review
DELETE {{baseUrl}}/product-reviews/{{productReviewId}}
